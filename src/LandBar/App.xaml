<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LandBar.App" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <FontFamily x:Key="AppFont">pack://application:,,,/LandBar;component/Assets/Fonts/#Noto Sans SC</FontFamily>
    <SolidColorBrush x:Key="Ink" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Muted" Color="#8C8C94"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#202023"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#303036"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#414149"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#9494A3"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D4D4DC"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <Border x:Name="Switch" Grid.Column="1" Width="34" Height="20" CornerRadius="10" Background="#27272F" BorderThickness="1" BorderBrush="#3A3A44" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Ellipse x:Name="Thumb" Fill="#BBBBC7" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="ThumbPosition"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Switch" Property="Background" Value="#AECDB7"/>
                <Setter TargetName="Switch" Property="BorderBrush" Value="#AECDB7"/>
                <Setter TargetName="Thumb" Property="Fill" Value="#18231C"/>
                <Setter TargetName="Thumb" Property="Margin" Value="16,0,0,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Switch" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Switch" Property="BorderBrush" Value="#E0E0E7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
