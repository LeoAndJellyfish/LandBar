<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LandBar</AssemblyName>
    <AssemblyTitle>LandBar</AssemblyTitle>
    <Product>LandBar</Product>
    <ApplicationIcon>Assets/Brand/LandBar.ico</ApplicationIcon>
    <Version>0.5.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LandBar.Core/LandBar.Core.csproj" />
    <ProjectReference Include="../LandBar.Plugins/LandBar.Plugins.csproj" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Brand/LandBar.ico" />
    <None Update="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/focus-timer/*" Link="PluginExamples/focus-timer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../samples/pixel-pet/*" Link="PluginExamples/pixel-pet/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
