<?xml version="1.0" encoding="utf-8"?>
<!-- Animated hinting selects smooth grayscale glyphs on the layered window; it does not animate text. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:LandBar.Presentation" x:Class="LandBar.MainWindow" Title="LandBar" Width="164" Height="44" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False" FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated" FontSize="15" Foreground="#F2F2F4" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <!-- Match the painted CJK glyph center to the adjacent icon, without moving its line box. -->
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1.5"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Fixed icon canvases align painted geometry, independent of font baselines. -->
    <Style x:Key="LineIcon" TargetType="Path">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MediaIcon" TargetType="Path">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TouchSurface" Background="{TemplateBinding Background}" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TouchSurface" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TouchSurface" Property="Opacity" Value="0.25"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.09"/>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.09"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="CardTemplate">
      <Border Width="{Binding CardWidth}" Padding="5,0,5,0">
        <Border Background="{Binding AmbientBrush}" CornerRadius="24" Padding="18,9,18,14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="26"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="5" Height="5" Fill="{Binding StatusColor}" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding Source}" Foreground="#B8B8C4" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="{Binding SourceWidth}"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Foreground="#91919C" HorizontalAlignment="Right" Tag="{Binding Id}" Visibility="{Binding DismissVisibility}" Click="Dismiss_Click" AutomationProperties.Name="关闭提示">
              <Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/>
            </Button>
            <Grid Grid.Row="1" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="{Binding CoverSize}" Height="{Binding CoverSize}" CornerRadius="17" HorizontalAlignment="Left" Background="{Binding AccentBackground}" Margin="0,0,18,0">
                <Grid>
                  <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Image Source="{Binding Artwork}" Stretch="UniformToFill" Clip="{Binding CoverClip}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{Binding TitleSize}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Body}" Foreground="#B8B8C4" FontSize="15" Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46" LineHeight="23"/>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0" Visibility="{Binding MediaVisibility}">
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="PreviousTrack_Click" IsEnabled="{Binding CanGoPrevious}" AutomationProperties.Name="上一首">
                <Path Style="{StaticResource MediaIcon}" Data="M 5,5 L 7,5 L 7,19 L 5,19 Z M 18,5 L 8,12 L 18,19 Z" Fill="#D8D8E0">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.285714286" ScaleY="1.285714286"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="PlayPause_Click" IsEnabled="{Binding CanTogglePlayPause}" AutomationProperties.Name="{Binding PlayPauseLabel}" Margin="20,0" Background="#EEEEF1" Width="46" Height="46">
                <Path Style="{StaticResource MediaIcon}" Data="{Binding PlayPauseGeometry}" Fill="#111114">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.0625" ScaleY="1.0625"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="NextTrack_Click" IsEnabled="{Binding CanGoNext}" AutomationProperties.Name="下一首">
                <Path Style="{StaticResource MediaIcon}" Data="M 17,5 L 19,5 L 19,19 L 17,19 Z M 6,5 L 16,12 L 6,19 Z" Fill="#D8D8E0">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.285714286" ScaleY="1.285714286"/></Path.RenderTransform>
                </Path>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="HoverSurface" ClipToBounds="True" UseLayoutRounding="False" SnapsToDevicePixels="False" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" PreviewMouseWheel="Island_MouseWheel" MouseRightButtonUp="ControlCenter_RightClick">
    <p:RoundedClipBorder x:Name="Island" Width="164" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="#08080A" BorderBrush="#2B2B32" BorderThickness="0.7" CornerRadius="22"/>
      <Grid x:Name="IslandViewport" UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Grid x:Name="ContentLayout" HorizontalAlignment="Center" VerticalAlignment="Top" Width="164" Height="44" UseLayoutRounding="False" SnapsToDevicePixels="False">
          <Grid x:Name="CompactView" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" Margin="15,0" MouseLeftButtonUp="ToggleActivity_Click" Cursor="Hand" AutomationProperties.Name="展开活动">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="48" Height="28">
              <Border x:Name="SecondCover" Width="26" Height="26" CornerRadius="8" Background="#25252D" HorizontalAlignment="Right" Visibility="Collapsed">
                <Image x:Name="SecondaryArtwork" Stretch="UniformToFill">
                  <Image.Clip>
                    <RectangleGeometry Rect="0,0,26,26" RadiusX="8" RadiusY="8"/>
                  </Image.Clip>
                </Image>
              </Border>
              <Border Width="28" Height="28" CornerRadius="8" Background="#1C1C22" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock x:Name="CompactGlyph" Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B6C9BA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="CompactArtwork" Stretch="UniformToFill">
                    <Image.Clip>
                      <RectangleGeometry Rect="0,0,28,28" RadiusX="8" RadiusY="8"/>
                    </Image.Clip>
                  </Image>
                </Grid>
              </Border>
            </Grid>
            <StackPanel x:Name="AudioBars" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border x:Name="AudioBar1" Width="2" Height="14" CornerRadius="1" Background="#A9CBB1" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleY="0.5"/>
                </Border.RenderTransform>
              </Border>
              <Border x:Name="AudioBar2" Width="2" Height="14" CornerRadius="1" Background="#A9CBB1" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleY="0.5"/>
                </Border.RenderTransform>
              </Border>
              <Border x:Name="AudioBar3" Width="2" Height="14" CornerRadius="1" Background="#A9CBB1" Margin="1.5,0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleY="0.5"/>
                </Border.RenderTransform>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ClockLabel" Grid.Column="2" Foreground="#B9B9C4" VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="14"/>
          </Grid>
          <Grid x:Name="ActivityView" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" Visibility="Collapsed" Margin="6,7,6,6" MouseLeftButtonUp="ActivitySurface_Click">
            <Grid.RowDefinitions>
              <RowDefinition Height="44"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,0">
              <StackPanel x:Name="ActivityTabs" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MediaTab" Content="媒体" Background="#24242B" Foreground="#F2F2F4" Padding="13,6" Click="MediaTab_Click"/>
                <Button x:Name="NotificationsTab" Content="通知" Background="Transparent" Foreground="#92929F" Padding="13,6" Margin="5,0,0,0" Click="NotificationsTab_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ClearNotificationsButton" Content="清空消息" Visibility="Collapsed" Background="Transparent" Foreground="#A2A2AE" FontSize="14" Height="32" Padding="10,0" Margin="0,0,6,0" Click="ClearNotifications_Click" AutomationProperties.Name="清空消息"/>
                <Button Style="{StaticResource IconButton}" Foreground="#93939F" Click="ControlCenter_Click" AutomationProperties.Name="控制中心">
                  <Path Style="{StaticResource LineIcon}" Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M5,2 L5,6 M11,6 L11,10 M6,10 L6,14"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Foreground="#93939F" Click="Collapse_Click" AutomationProperties.Name="收起">
                  <Path Style="{StaticResource LineIcon}" Data="M3,10.5 L8,5.5 L13,10.5"/>
                </Button>
              </StackPanel>
            </Grid>
            <ItemsControl x:Name="EventItems" Grid.Row="1" Margin="0,3,0,0" ItemTemplate="{StaticResource CardTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="EmptyState" Grid.Row="1" Text="暂无媒体" FontSize="15" Foreground="#8A8A98" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel x:Name="PageControls" Height="28" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Style="{StaticResource IconButton}" Click="PreviousPage_Click" AutomationProperties.Name="上一组">
                <Path Style="{StaticResource LineIcon}" Data="M10.5,3 L5.5,8 L10.5,13"/>
              </Button>
              <ItemsControl x:Name="PageDots" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Ellipse Width="4" Height="4" Margin="4,0" Fill="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource IconButton}" Click="NextPage_Click" AutomationProperties.Name="下一组">
                <Path Style="{StaticResource LineIcon}" Data="M5.5,3 L10.5,8 L5.5,13"/>
              </Button>
            </StackPanel>
          </Grid>
          <Grid x:Name="ControlCenterView" UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="Collapsed" Margin="22,16,22,16">
            <Grid.Resources>
              <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="44"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Background" Value="#18181D"/>
                <Setter Property="Foreground" Value="#B6B6C2"/>
              </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="44"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="控制中心" Style="{StaticResource PageTitle}"/>
            <Button Style="{StaticResource IconButton}" Foreground="#8C8C97" HorizontalAlignment="Right" Click="Collapse_Click" AutomationProperties.Name="收起">
              <Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/>
            </Button>
            <Grid Grid.Row="1" Height="96" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Button AutomationProperties.Name="设置" Click="Settings_Click" Margin="0,0,5,0" Padding="12,14">
                <StackPanel>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"/>
                  <TextBlock Text="设置" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="QuietButton" AutomationProperties.Name="{Binding Text, ElementName=QuietLabel}" Grid.Column="1" Click="Quiet_Click" Margin="5,0,0,0" Padding="12,14">
                <StackPanel>
                  <Path Data="M 20,14 A 8,8 0 0 1 10,4 A 8,8 0 1 0 20,14 Z" Fill="#BBCAD5" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="QuietLabel" Text="暂停提示" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <Button x:Name="PreviewButton" Grid.Row="2" Height="46" Content="预览通知与媒体" Click="Demo_Click" Margin="0,10,0,0" Padding="12,0"/>
            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button x:Name="ReturnActivityButton" Style="{StaticResource FooterButton}" Content="返回活动" Click="OpenActivity_Click" Margin="0,0,5,0"/>
              <Button x:Name="ExitButton" Style="{StaticResource FooterButton}" Grid.Column="1" Content="退出" Foreground="#A4A4B0" Click="Exit_Click" Margin="5,0,0,0"/>
            </Grid>
          </Grid>
          <ScrollViewer x:Name="SettingsScroll" UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Margin" Value="0,24,4,24"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Grid Width="8" HorizontalAlignment="Center" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                          <Track.Resources>
                            <Style TargetType="RepeatButton">
                              <Setter Property="Focusable" Value="False"/>
                              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
                            </Style>
                          </Track.Resources>
                          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb Width="5" MinHeight="28" HorizontalAlignment="Center">
                              <Thumb.Style>
                                <Style TargetType="Thumb">
                                  <Setter Property="Background" Value="#41414B"/>
                                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="2.5"/></ControlTemplate></Setter.Value></Setter>
                                  <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#626270"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#81818F"/></Trigger>
                                  </Style.Triggers>
                                </Style>
                              </Thumb.Style>
                            </Thumb>
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
                        </Track>
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ScrollViewer.Resources>
            <Grid Margin="22,16,22,20">
              <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="ControlCenter_Click" AutomationProperties.Name="返回控制中心">
                  <Path Style="{StaticResource LineIcon}" Data="M10.5,3 L5.5,8 L10.5,13"/>
                </Button>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="6,0,0,0"/>
              </StackPanel>
              <Button Style="{StaticResource IconButton}" Foreground="#8C8C97" HorizontalAlignment="Right" Click="Collapse_Click" AutomationProperties.Name="收起">
                <Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/>
              </Button>
              <Border Grid.Row="1" Margin="0,14,0,16" Padding="15,10" CornerRadius="18" Background="#141418" BorderBrush="#25252D" BorderThickness="1">
                <StackPanel>
                  <Grid MinHeight="42">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Windows 通知" FontSize="15" VerticalAlignment="Center"/>
                    <Border x:Name="NotificationBadge" Grid.Column="1" Padding="9,4" CornerRadius="10" VerticalAlignment="Center" Background="#25252D">
                      <TextBlock x:Name="NotificationStatus" Text="检查中" FontSize="14" Foreground="#B8B8C4"/>
                    </Border>
                    <Button x:Name="PermissionButton" Grid.Column="2" Content="授权" FontSize="14" Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="RequestAccess_Click"/>
                    <TextBlock x:Name="NotificationHint" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Foreground="#B9ABA1" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,6"/>
                  </Grid>
                  <Border Height="1" Background="#28282F" Margin="0,7"/>
                  <Grid MinHeight="42">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="媒体控制" FontSize="15" VerticalAlignment="Center"/>
                    <Border x:Name="MediaBadge" Grid.Column="1" Padding="9,4" CornerRadius="10" VerticalAlignment="Center" Background="#25252D">
                      <TextBlock x:Name="MediaStatus" Text="检查中" FontSize="14" Foreground="#B8B8C4"/>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <CheckBox x:Name="PrivacyCheck" Content="隐藏消息内容" Click="Settings_Changed"/>
                <CheckBox x:Name="QuietCheck" Content="暂停弹出提示" Click="Settings_Changed"/>
                <CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动" Click="Startup_Changed"/>
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="无操作自动收起" FontSize="15"/>
                  <Border CornerRadius="15" Background="#141418" Padding="4" Margin="0,8,0,0">
                    <UniformGrid x:Name="AutoCollapseOptions" Columns="6" Height="36">
                      <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="1,0"/>
                          <Setter Property="FontSize" Value="14"/>
                        </Style>
                      </UniformGrid.Resources>
                      <Button Content="1 秒" Tag="1" Click="AutoCollapse_Click" AutomationProperties.Name="1 秒后自动收起"/>
                      <Button Content="2 秒" Tag="2" Click="AutoCollapse_Click" AutomationProperties.Name="2 秒后自动收起"/>
                      <Button Content="3 秒" Tag="3" Click="AutoCollapse_Click" AutomationProperties.Name="3 秒后自动收起"/>
                      <Button Content="4 秒" Tag="4" Click="AutoCollapse_Click" AutomationProperties.Name="4 秒后自动收起"/>
                      <Button Content="5 秒" Tag="5" Click="AutoCollapse_Click" AutomationProperties.Name="5 秒后自动收起"/>
                      <Button Content="永不" Tag="0" Click="AutoCollapse_Click" AutomationProperties.Name="永不自动收起"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B9ABA1" Margin="0,8,0,0" FontSize="14"/>
              </StackPanel>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScreenButton" Content="屏幕：1" Click="Screen_Click" Margin="0,0,5,0" FontSize="14"/>
                <Button x:Name="OffsetButton" Grid.Column="1" Content="顶部间距：12" Click="Offset_Click" Margin="5,0,0,0" FontSize="14"/>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
        <Image x:Name="TransitionGhost" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="None" Visibility="Collapsed"/>
      </Grid>
  </Grid>
</Window>
