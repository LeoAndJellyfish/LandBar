<?xml version="1.0" encoding="utf-8"?>
<!-- Animated hinting selects smooth grayscale glyphs on the layered window; it does not animate text. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:LandBar.Presentation" x:Class="LandBar.MainWindow" Title="LandBar" Width="164" Height="44" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False" FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated" FontSize="15" Foreground="#F2F2F4" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
              <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Margin" Value="0,24,4,24"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Grid Width="8" HorizontalAlignment="Center" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                          <Track.Resources>
                            <Style TargetType="RepeatButton">
                              <Setter Property="Focusable" Value="False"/>
                              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
                            </Style>
                          </Track.Resources>
                          <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb Width="5" MinHeight="28" HorizontalAlignment="Center">
                              <Thumb.Style>
                                <Style TargetType="Thumb">
                                  <Setter Property="Background" Value="#41414B"/>
                                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="2.5"/></ControlTemplate></Setter.Value></Setter>
                                  <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#626270"/></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#81818F"/></Trigger>
                                  </Style.Triggers>
                                </Style>
                              </Thumb.Style>
                            </Thumb>
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
                        </Track>
                      </Grid>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <!-- Match the painted CJK glyph center to the adjacent icon, without moving its line box. -->
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1.5"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Fixed icon canvases align painted geometry, independent of font baselines. -->
    <Style x:Key="LineIcon" TargetType="Path">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MediaIcon" TargetType="Path">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Stretch" Value="None"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TouchSurface" Background="{TemplateBinding Background}" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TouchSurface" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TouchSurface" Property="Opacity" Value="0.25"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.09"/>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.09"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="CardTemplate">
      <Border Width="{Binding CardWidth}" Padding="5,0,5,0">
        <Border Background="{Binding AmbientBrush}" CornerRadius="20" Padding="14,6,14,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="22"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="5" Height="5" Fill="{Binding StatusColor}" Margin="0,0,7,0"/>
              <TextBlock Text="{Binding Source}" Foreground="#B8B8C4" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="{Binding SourceWidth}"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Foreground="#91919C" HorizontalAlignment="Right" Tag="{Binding Id}" Visibility="{Binding DismissVisibility}" Click="Dismiss_Click" AutomationProperties.Name="关闭提示">
              <Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/>
            </Button>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="{Binding CoverSize}" Height="{Binding CoverSize}" CornerRadius="14" HorizontalAlignment="Left" Background="{Binding AccentBackground}" Margin="0,0,12,0">
                <Grid>
                  <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Image Source="{Binding Artwork}" Stretch="UniformToFill" Clip="{Binding CoverClip}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{Binding TitleSize}" LineHeight="26" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Body}" Foreground="#B8B8C4" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding PluginVisibility}">
              <Border Height="4" CornerRadius="2" Background="#292D30" Visibility="{Binding ProgressVisibility}" Margin="0,0,0,8" ClipToBounds="True">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Foreground="#BEDDC9" Background="Transparent" BorderThickness="0"/>
              </Border>
              <ItemsControl ItemsSource="{Binding PluginActions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" Tag="{Binding}" Height="36" FontSize="14" Padding="8,0" Margin="3,0" Click="PluginAction_Click" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                      <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Button.ContentTemplate>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding MediaVisibility}">
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="PreviousTrack_Click" IsEnabled="{Binding CanGoPrevious}" AutomationProperties.Name="上一首">
                <Path Style="{StaticResource MediaIcon}" Data="M 5,5 L 7,5 L 7,19 L 5,19 Z M 18,5 L 8,12 L 18,19 Z" Fill="#D8D8E0">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.285714286" ScaleY="1.285714286"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="PlayPause_Click" IsEnabled="{Binding CanTogglePlayPause}" AutomationProperties.Name="{Binding PlayPauseLabel}" Margin="18,0" Background="#EEEEF1" Width="40" Height="40">
                <Path Style="{StaticResource MediaIcon}" Data="{Binding PlayPauseGeometry}" Fill="#111114">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.0625" ScaleY="1.0625"/></Path.RenderTransform>
                </Path>
              </Button>
              <Button Style="{StaticResource PlayerButton}" Tag="{Binding SessionId}" Click="NextTrack_Click" IsEnabled="{Binding CanGoNext}" AutomationProperties.Name="下一首">
                <Path Style="{StaticResource MediaIcon}" Data="M 17,5 L 19,5 L 19,19 L 17,19 Z M 6,5 L 16,12 L 6,19 Z" Fill="#D8D8E0">
                  <Path.RenderTransform><ScaleTransform ScaleX="1.285714286" ScaleY="1.285714286"/></Path.RenderTransform>
                </Path>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="HoverSurface" ClipToBounds="True" UseLayoutRounding="False" SnapsToDevicePixels="False" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" PreviewMouseWheel="Island_MouseWheel" MouseRightButtonUp="ControlCenter_RightClick">
    <p:RoundedClipBorder x:Name="Island" Width="164" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" UseLayoutRounding="False" SnapsToDevicePixels="False" Background="#08080A" BorderBrush="#2B2B32" BorderThickness="0.7" CornerRadius="22"/>
      <Grid x:Name="IslandViewport" UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Grid x:Name="ContentLayout" HorizontalAlignment="Center" VerticalAlignment="Top" Width="164" Height="44" UseLayoutRounding="False" SnapsToDevicePixels="False">
          <Grid x:Name="CompactView" UseLayoutRounding="True" Background="Transparent" Margin="12,0" MouseLeftButtonUp="ToggleActivity_Click" Cursor="Hand" AutomationProperties.Name="展开活动">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <p:PluginViewPresenter x:Name="PluginIdleLeft" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" MouseLeftButtonUp="PluginIdle_Click"/>
          <Grid x:Name="BuiltinCompactView" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="Transparent" Grid.Column="1" Margin="0" MouseLeftButtonUp="ToggleActivity_Click" Cursor="Hand" AutomationProperties.Name="展开活动">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
