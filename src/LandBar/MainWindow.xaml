              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ScrollViewer x:Name="ActivityTabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="HorizontalOnly" Margin="0,0,8,0">
              <StackPanel x:Name="ActivityTabs" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MediaTab" Content="媒体" Background="#24242B" Foreground="#F2F2F4" Padding="9,5" Click="MediaTab_Click"/>
                <Button x:Name="NotificationsTab" Content="通知" Background="Transparent" Foreground="#92929F" Padding="9,5" Margin="4,0,0,0" Click="NotificationsTab_Click"/>
                <Button x:Name="PluginsTab" Visibility="Collapsed" Content="插件" Background="Transparent" Foreground="#92929F" Padding="9,5" Margin="4,0,0,0" Click="PluginsTab_Click"/>
                <ItemsControl x:Name="PluginTabItems">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Content="{Binding Title}" Tag="{Binding Key}" Background="{Binding Background}" Foreground="{Binding Foreground}" Padding="9,5" Margin="4,0,0,0" MaxWidth="140" ToolTip="{Binding Title}" Click="PluginTab_Click">
                      <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Button.ContentTemplate>
