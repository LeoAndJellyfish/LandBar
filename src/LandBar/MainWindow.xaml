            <TextBlock x:Name="ClockLabel" Grid.ColumnSpan="3" Foreground="#D2D2DA" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontFamily="{StaticResource AppFont}" FontSize="16" Typography.NumeralAlignment="Tabular"/>
