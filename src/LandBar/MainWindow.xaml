              <Grid Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconButton}" Click="ControlCenter_Click" AutomationProperties.Name="返回控制中心"><Path Style="{StaticResource LineIcon}" Data="M10.5,3 L5.5,8 L10.5,13"/></Button>
                  <TextBlock Text="插件" Style="{StaticResource PageTitle}" Margin="6,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Collapse_Click" AutomationProperties.Name="收起"><Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/></Button>
              </Grid>
              <TextBlock Text="自定义活动、进度与操作。" Foreground="#B8B8C4" FontSize="15" Margin="0,8,0,6"/>
              <TextBlock Text="插件以当前 Windows 用户权限运行。请仅启用信任的本地程序。" Foreground="#9999A6" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="打开插件目录" Click="OpenPluginsFolder_Click" Height="40" Padding="8,0" Margin="0,0,5,0" FontSize="14"/>
                <Button Grid.Column="1" Content="刷新" Click="RefreshPlugins_Click" Height="40" Padding="8,0" Margin="5,0,0,0" FontSize="14"/>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="计时器示例" Tag="focus-timer" Click="InstallPluginExample_Click" Height="40" Margin="0,0,4,0" Padding="8,0" FontSize="14"/>
                <Button Grid.Column="1" Content="像素伙伴示例" Tag="pixel-pet" Click="InstallPluginExample_Click" Height="40" Margin="4,0,0,0" Padding="8,0" FontSize="14"/>
              </Grid>
              <TextBlock x:Name="PluginManagementHint" Foreground="#BEDDC9" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
              <ItemsControl x:Name="PluginList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="18" Background="#141418" BorderBrush="#25252D" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Description}" Foreground="#A2A2AF" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,0"/>
                          <TextBlock Text="{Binding StatusText}" Foreground="#BEDDC9" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ToggleText}" Tag="{Binding Id}" IsEnabled="{Binding CanToggle}" Click="TogglePlugin_Click" Height="36" MinWidth="60" Padding="10,0" VerticalAlignment="Top" FontSize="14"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel x:Name="PluginViewsSection">
              <TextBlock Text="界面与空闲插槽" FontSize="15" Margin="0,12,0,10"/>
              <Button x:Name="PluginViewsToggle" Content="停用插件界面" Click="TogglePluginViews_Click" Height="38" FontSize="14" Margin="0,0,0,8"/>
              <ItemsControl x:Name="PluginViewChoices"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding Title}" FontSize="15"/><TextBlock Text="{Binding Source}" Foreground="#9999A6" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <Button Grid.Column="1" Content="{Binding ToggleText}" Tag="{Binding Key}" Click="SelectPluginView_Click" FontSize="14" Padding="10,0" Height="36" MinWidth="60" Margin="8,0,0,0"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
              <TextBlock x:Name="PluginsEmptyHint" Text="尚未安装插件" Foreground="#8A8A98" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsScroll" UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/></ScrollViewer.Resources>
            <Grid Margin="18,12,18,16">
              <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="ControlCenter_Click" AutomationProperties.Name="返回控制中心">
                  <Path Style="{StaticResource LineIcon}" Data="M10.5,3 L5.5,8 L10.5,13"/>
                </Button>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="6,0,0,0"/>
              </StackPanel>
              <Button Style="{StaticResource IconButton}" Foreground="#8C8C97" HorizontalAlignment="Right" Click="Collapse_Click" AutomationProperties.Name="收起">
                <Path Style="{StaticResource LineIcon}" Data="M4,4 L12,12 M12,4 L4,12"/>
              </Button>
              <Border Grid.Row="1" Margin="0,10,0,10" Padding="15,10" CornerRadius="18" Background="#141418" BorderBrush="#25252D" BorderThickness="1">
                <StackPanel>
                  <Grid MinHeight="38">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Windows 通知" FontSize="15" VerticalAlignment="Center"/>
                    <Border x:Name="NotificationBadge" Grid.Column="1" Padding="9,4" CornerRadius="10" VerticalAlignment="Center" Background="#25252D">
                      <TextBlock x:Name="NotificationStatus" Text="检查中" FontSize="14" Foreground="#B8B8C4"/>
                    </Border>
                    <Button x:Name="PermissionButton" Grid.Column="2" Content="授权" FontSize="14" Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="RequestAccess_Click"/>
                    <TextBlock x:Name="NotificationHint" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Foreground="#B9ABA1" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,6"/>
                  </Grid>
                  <Border Height="1" Background="#28282F" Margin="0,7"/>
                  <Grid MinHeight="38">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="媒体控制" FontSize="15" VerticalAlignment="Center"/>
                    <Border x:Name="MediaBadge" Grid.Column="1" Padding="9,4" CornerRadius="10" VerticalAlignment="Center" Background="#25252D">
                      <TextBlock x:Name="MediaStatus" Text="检查中" FontSize="14" Foreground="#B8B8C4"/>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <CheckBox x:Name="PrivacyCheck" Height="36" Content="隐藏消息内容" Click="Settings_Changed"/>
                <CheckBox x:Name="QuietCheck" Height="36" Content="暂停弹出提示" Click="Settings_Changed"/>
                <CheckBox x:Name="StartupCheck" Height="36" Content="登录 Windows 时启动" Click="Startup_Changed"/>
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="无操作自动收起" FontSize="15"/>
                  <Border CornerRadius="15" Background="#141418" Padding="4" Margin="0,8,0,0">
                    <UniformGrid x:Name="AutoCollapseOptions" Columns="6" Height="36">
                      <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="1,0"/>
                          <Setter Property="FontSize" Value="14"/>
                        </Style>
                      </UniformGrid.Resources>
                      <Button Content="1 秒" Tag="1" Click="AutoCollapse_Click" AutomationProperties.Name="1 秒后自动收起"/>
                      <Button Content="2 秒" Tag="2" Click="AutoCollapse_Click" AutomationProperties.Name="2 秒后自动收起"/>
                      <Button Content="3 秒" Tag="3" Click="AutoCollapse_Click" AutomationProperties.Name="3 秒后自动收起"/>
                      <Button Content="4 秒" Tag="4" Click="AutoCollapse_Click" AutomationProperties.Name="4 秒后自动收起"/>
                      <Button Content="5 秒" Tag="5" Click="AutoCollapse_Click" AutomationProperties.Name="5 秒后自动收起"/>
                      <Button Content="永不" Tag="0" Click="AutoCollapse_Click" AutomationProperties.Name="永不自动收起"/>
                    </UniformGrid>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="StatusDetail" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B9ABA1" Margin="0,8,0,0" FontSize="14"/>
              </StackPanel>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScreenButton" Content="屏幕：1" Click="Screen_Click" Margin="0,0,5,0" FontSize="14"/>
                <Button x:Name="OffsetButton" Grid.Column="1" Content="顶部间距：12" Click="Offset_Click" Margin="5,0,0,0" FontSize="14"/>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
        <Image x:Name="TransitionGhost" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="None" Visibility="Collapsed"/>
      </Grid>
  </Grid>
</Window>
