                </Image>
              </Border>
              <Border Width="28" Height="28" CornerRadius="8" Background="#1C1C22" HorizontalAlignment="Left">
                <Grid>
                  <TextBlock x:Name="CompactGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B6C9BA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="CompactArtwork" Stretch="UniformToFill">
