<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LandBar/LandBar.csproj" />
    <None Include="../../src/LandBar/App.xaml" Link="Production-App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/pixel-pet/*" Link="Samples/pixel-pet/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/codex-balance/plugin.py" Link="Samples/codex-balance/plugin.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
